<%- include('../partials/header') %>
<section class="page-heading heading-row">
  <div><p class="eyebrow">STAFF VIEW</p><h1>Order Queue</h1><p>Prepare drinks in order, then mark them ready for pickup.</p></div>
  <a class="button secondary" href="/menu">New patron order</a>
</section>

<% if (orders.length === 0) { %>
  <section class="empty-state"><div>✓</div><h2>The bar is all caught up</h2><p>New cocktail orders will appear here.</p></section>
<% } else { %>
  <section class="queue-list">
    <% orders.forEach((order) => { %>
      <article class="queue-item status-<%= order.status %>">
        <div class="order-number">#<%= order.id %></div>
        <div class="order-main">
          <div class="order-title"><h2><%= order.quantity %> × <%= order.cocktail_name %></h2><span class="badge"><%= order.status %></span></div>
          <p>For <strong><%= order.customer_name %></strong> · $<%= order.total.toFixed(2) %> · <%= new Date(order.created_at + 'Z').toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }) %></p>
          <% if (order.notes) { %><p class="notes">“<%= order.notes %>”</p><% } %>
        </div>
        <div class="order-actions">
          <% if (order.status !== 'ready') { %><a class="text-link" href="/orders/<%= order.id %>/edit">Edit</a><% } %>
          <% if (order.status === 'queued') { %>
            <form action="/orders/<%= order.id %>/status" method="post"><input type="hidden" name="status" value="preparing"><button class="button secondary small">Start preparing</button></form>
          <% } else if (order.status === 'preparing') { %>
            <form action="/orders/<%= order.id %>/status" method="post"><input type="hidden" name="status" value="ready"><button class="button primary small">Ready for pickup</button></form>
          <% } else { %><strong class="ready-label">Ready for server</strong><% } %>
        </div>
      </article>
    <% }) %>
  </section>
<% } %>
<%- include('../partials/footer') %>
